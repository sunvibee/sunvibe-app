# Copy this to .env and fill in your values for LOCAL development.
# On Railway all variables are set in the dashboard — do NOT commit .env to git.

# PostgreSQL connection string
# - LOCAL: postgresql://user:password@localhost:5432/sunvibee
# - RAILWAY: provided automatically when you add the Postgres plugin (postgres-ssl image).
#   Railway's DATABASE_URL already includes the host/port/creds; SSL is handled automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/sunvibee

# Secret key for signing JWT tokens — use a long random string (32+ chars)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Shared secret that ESP devices send to fetch WiFi credentials
ESP_SECRET=change_this_to_a_secret_for_esp

# Port (Railway sets this automatically via the PORT env var)
PORT=3000
